{
  "description": "Power Plant random encounters (FRLG). Walk back and forth until a wild battle starts, identify the species against the sprite library, flee if it is an ordinary one. ROIs are in native GBA pixels (240x160). Step types: press | pause | hold | combo | walk_until_encounter | wait_for_screen | check_library | verify_screen | check_shiny. Add \"jitter\": 0 to any timed step to opt out of the global timing jitter.",
  "hunt_name": "powerplant",
  "rois": {
    "battle_detector": [80, 136, 40, 20],
    "enemy_sprite": [143, 8, 64, 64],
    "battle_menu": [136, 124, 40, 24]
  },
  "templates": {
    "battle_detector": "./screenshots/templates/battle_ready.png",
    "battle_menu": "./screenshots/templates/battle_menu.png"
  },
  "sprite_library": "./sprite_library/powerplant",
  "on_not_shiny": "flee",
  "on_unknown_sprite": "pause",
  "max_flee_attempts": 3,
  "max_consecutive_resets": 3,
  "encounter_sequence": [
    {
      "type": "walk_until_encounter",
      "keys": ["left", "left", "left", "right", "right", "right"],
      "hold_keys": ["z"],
      "step_duration": 0.35,
      "jitter": 0,
      "poll_every": 4,
      "max_steps": 200,
      "refocus_every": 50,
      "detect_template": "battle_detector",
      "detect_roi": "battle_detector"
    },
    {
      "type": "wait_for_screen",
      "template": "battle_detector",
      "roi": "battle_detector",
      "expect": "present",
      "timeout": 15.0,
      "delay_after": 3.0
    },
    {
      "type": "check_library",
      "roi": "enemy_sprite",
      "samples": 2,
      "sample_gap": 0.2
    }
  ],
  "flee_sequence": [
    {
      "type": "press",
      "key": "x",
      "delay_after": 1,
      "jitter": 0
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 1.5,
      "jitter": 0
    },
    {
      "type": "wait_for_screen",
      "template": "battle_menu",
      "roi": "battle_menu",
      "expect": "present",
      "threshold": 0.7,
      "timeout": 12.0
    },
    {
      "type": "press",
      "key": "right",
      "delay_after": 0.45,
      "jitter": 0
    },
    {
      "type": "press",
      "key": "down",
      "delay_after": 0.45,
      "jitter": 0
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.6,
      "jitter": 0
    },
    {
      "type": "press",
      "key": "x",
      "jitter": 0
    },
    {
      "type": "wait_for_screen",
      "template": "battle_detector",
      "roi": "battle_detector",
      "expect": "absent",
      "timeout": 10.0
    }
  ],
  "recover_sequence": [
    {
      "type": "press",
      "key": "z",
      "delay_after": 0.35,
      "jitter": 0
    },
    {
      "type": "press",
      "key": "z",
      "delay_after": 0.35,
      "jitter": 0
    },
    {
      "type": "press",
      "key": "z",
      "delay_after": 0.35,
      "jitter": 0
    },
    {
      "type": "press",
      "key": "z",
      "delay_after": 0.35,
      "jitter": 0
    }
  ]
}
