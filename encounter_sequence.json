{
  "description": "Custom encounter sequence. Supported step types: press | pause | hold | combo | verify_screen | check_shiny. Input keys: x (A button), z (B button), enter (Start), backspace (Select), up | down | left | right (D-pad). verify_screen takes a screenshot and checks it against the encounter template \u2014 fails to restart if wrong screen. check_shiny compares the screenshot to your calibration reference \u2014 stops the hunt if shiny, restarts if not. Both screenshot steps use config defaults but accept optional overrides (threshold, reference_path).",
  "encounter_sequence": [
    {
      "type": "verify_screen"
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.5
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "up",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "up",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "z",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "enter",
      "delay_after": 0.4
    },
    {
      "type": "pause",
      "duration": 2.0
    },
    {
      "type": "press",
      "key": "down",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "right",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.4
    },
    {
      "type": "press",
      "key": "x",
      "delay_after": 0.4
    },
    {
      "type": "check_shiny"
    },
    {
      "type": "combo",
      "keys": ["x", "z", "enter", "backspace"],
      "hold_duration": 0.2,
      "delay_after": 4.0
    },
    { "type": "press", "key": "enter", "delay_after": 3.5 },
    { "type": "press", "key": "enter", "delay_after": 2.0 },
    { "type": "press", "key": "enter", "delay_after": 3.0 },
    { "type": "press", "key": "x", "delay_after": 1.0 },
    { "type": "press", "key": "z", "delay_after": 4.0 }
  ]
}
